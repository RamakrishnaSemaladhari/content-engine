name = "fivecheckmate-insights"
main = "src/index.js"
compatibility_date = "2026-10-19"

[[d1_databases]]
binding = "DB"
database_name = "fivecheckmate-insights-staging"
database_id = "a10a355f-aef6-4dee-81a6-b7156925ad0c"

[[d1_databases]]
binding = "CONTENT_DB"
database_name = "fivecheckmate-content-engine"
database_id = "050c8bbf-172e-4369-8058-40d84052d2b2"

# Existing BOOTSTRAP_TOKEN and SESSION_SECRET must remain configured as Worker secrets.
# Do not put secret values in this file or commit them.
